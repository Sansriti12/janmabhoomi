# Janmabhoomi Website — Frontend Environment Variables

# Public canonical URL of the deployed website
NEXT_PUBLIC_SITE_URL=https://www.janmabhoomi.in

# Backend API base URL
# Local development: http://127.0.0.1:4000
# Production: Set to your hosted backend API URL (e.g., https://api.janmabhoomi.in)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# Data provider toggle:
# - "true" to fetch dynamic articles, categories, and hero content from the Fastify API
# - "false" or unset to use the offline mock dataset
NEXT_PUBLIC_USE_API=true
