# ============================================================================
# Janmabhoomi Backend Environment Configuration (Example)
# ============================================================================

# Runtime Environment
NODE_ENV=development

# Server Port and Host
PORT=4000
HOST=127.0.0.1

# Allowed CORS Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Connection String (Local Development)
DATABASE_URL=postgresql://user:password@localhost:5432/janmabhoomi_dev?schema=public

# PayU Sandbox Credentials (Pending confirmation in Phase 3D)
# PAYU_MERCHANT_KEY=test_key
# PAYU_MERCHANT_SALT=test_salt
